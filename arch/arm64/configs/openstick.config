# SPDX-License-Identifier: GPL-2.0-only
#
# Configuration fragment for Qualcomm MSM8916 OpenStick / 4G USB Wi-Fi dongles
# (SP970, UF896, UFI001C, UZ801, etc.)
#
# Usage:
#   make msm8916_defconfig openstick.config
#

# Headless crash recovery (auto-reboot after 5s on kernel panic)
CONFIG_PANIC_TIMEOUT=5

# Memory compression (ZRAM with ZSTD default + ZSWAP for 384-512 MB RAM sticks)
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# USB Composite Gadget & Virtual Serial (/dev/ttyGS*, CDC-ACM, Generic Serial, console=ttyGS0)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_G_SERIAL=m

# USB OTG Host peripherals & Virtual Serial (/dev/ttyACM*, /dev/ttyUSB*)
CONFIG_USB_ACM=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_XR=m

# Networking, NAT/firewall (nftables), and VPN (WireGuard / TUN)
CONFIG_IPV6=y
CONFIG_TUN=y
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m

# Container & external/network filesystems
CONFIG_OVERLAY_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_CIFS=m
CONFIG_NFS_FS=m
